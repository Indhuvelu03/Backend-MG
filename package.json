{
  "name": "vehicle-service-ai-backend",
  "version": "1.0.0",
  "description": "AI Vehicle Service Feedback & Invoice Verification System Backend",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "test": "jest --runInBand --detectOpenHandles",
    "lint": "eslint \"/**/*.js\"",
    "lint:fix": "eslint \"**/*.js\" --fix",
    "format": "prettier --write \"*.js\" \"tests/**/*.js\"",
    "migrate:complaints": "node scripts/migrate-complaints.js",
    "seed:admin": "node scripts/seed-admin.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.554.0",
    "@supabase/supabase-js": "^2.112.3",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.7.8",
    "cors": "^2.8.5",
    "dns": "^0.2.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "groq-sdk": "^1.5.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.2.4",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.13",
    "openai": "^4.33.0",
    "pdf-parse": "^1.1.1",
    "resend": "^6.20.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "tesseract.js": "^5.0.5",
    "twilio": "^5.0.4",
    "whisper-node": "^1.1.1",
    "winston": "^3.12.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.1.8",
    "nodemon": "^3.1.14",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "supertest": "^6.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
