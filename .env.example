# Use the same values on both the Render web service and worker service.
NODE_ENV=production
PORT=5000
CLIENT_URL=https://your-frontend.vercel.app
PUBLIC_FEEDBACK_BASE_URL=https://your-frontend.vercel.app/feedback
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=24h
GROQ_API_KEY=your_groq_key
RESEND_API_KEY=re_your_resend_key
RESEND_FROM_EMAIL=AutoAudit AI <notifications@your-verified-domain.com>
REDIS_URL=rediss://default:password@your-upstash-host:6379
MANAGER_EMAIL=manager@yourcompany.com
# Optional generic SMTP relay. Use port 2525 on Render's free tier.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=your_smtp_login
SMTP_PASS=your_smtp_key
SMTP_FROM_EMAIL=AutoAudit AI <your-verified-sender@gmail.com>
# Optional: omit these only if SMS/WhatsApp are intentionally disabled.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_SMS_NUMBER=+15005550006
TWILIO_WHATSAPP_NUMBER=+14155238886
